// 2. ERD — 자동 생성 파일 (2_erd.py 를 고치고 다시 실행)
digraph erd {
  graph [rankdir=LR, fontname="Apple SD Gothic Neo", fontsize=20, labelloc=t, nodesep=0.6, ranksep=1.1, pad=0.3,
         label=<<b>DeepLog-Guard DB 구조 (ERD)</b><br/><font point-size="12" color="#475569">SQLite 파일 1개 · 테이블 3개 · 쓰기: 백엔드·알림 작업자 / 읽기: 대시보드 (읽기 전용)</font><br/> >];
  node [shape=plain, fontname="Apple SD Gothic Neo", fontsize=11];
  edge [fontname="Apple SD Gothic Neo", fontsize=10.5, color="#334155", penwidth=1.4];

  session_results [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
<tr><td colspan="4" bgcolor="#FEF3C7" align="left"><font point-size="15"><b>session_results</b></font><br/><font point-size="10" color="#334155">세션(블록) 종료 판정 결과 · 블록·모델당 1행</font></td></tr>
<tr><td colspan="4" bgcolor="#F8FAFC" align="left"><font point-size="9.5" color="#475569">쓰기: 백엔드 (POST /sessions/close, 장시간 무소식 블록 자동) · 재판정 시 같은 행 갱신</font></td></tr>
<tr><td bgcolor="#FDE68A" width="26" port="block_id_k"><font point-size="9"><b>PK</b></font></td><td align="left" port="block_id"><b>block_id</b></td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="block_id_r"><font color="#475569" point-size="9.5">블록 ID</font></td></tr>
<tr><td bgcolor="#FDE68A" width="26" port="model_name_k"><font point-size="9"><b>PK</b></font></td><td align="left" port="model_name"><b>model_name</b></td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="model_name_r"><font color="#475569" point-size="9.5">판정 모델</font></td></tr>
<tr><td bgcolor="white" width="26" port="closed_at_k"> </td><td align="left" port="closed_at">closed_at</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="closed_at_r"><font color="#475569" point-size="9.5">종료 판정 시각 (UTC)</font></td></tr>
<tr><td bgcolor="white" width="26" port="close_reason_k"> </td><td align="left" port="close_reason">close_reason</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="close_reason_r"><font color="#475569" point-size="9.5">idle 자동 / manual 수동</font></td></tr>
<tr><td bgcolor="#DBEAFE" width="26" port="last_log_id_k"><font point-size="9"><b>FK</b></font></td><td align="left" port="last_log_id">last_log_id</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="last_log_id_r"><font color="#475569" point-size="9.5">그 블록의 마지막 logs.id</font></td></tr>
<tr><td bgcolor="white" width="26" port="anomaly_score_k"> </td><td align="left" port="anomaly_score">anomaly_score</td><td align="left"><font color="#64748B" point-size="9.5">REAL</font></td><td align="left" port="anomaly_score_r"><font color="#475569" point-size="9.5">EOS 판정 점수 (0~1)</font></td></tr>
<tr><td bgcolor="white" width="26" port="threshold_k"> </td><td align="left" port="threshold">threshold</td><td align="left"><font color="#64748B" point-size="9.5">REAL</font></td><td align="left" port="threshold_r"><font color="#475569" point-size="9.5">기준선 (0.5)</font></td></tr>
<tr><td bgcolor="white" width="26" port="is_anomaly_k"> </td><td align="left" port="is_anomaly">is_anomaly</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="is_anomaly_r"><font color="#475569" point-size="9.5">1 = 중간에 끊긴 세션</font></td></tr>
<tr><td bgcolor="white" width="26" port="reason_k"> </td><td align="left" port="reason">reason</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="reason_r"><font color="#475569" point-size="9.5">판정 이유</font></td></tr>
<tr><td bgcolor="white" width="26" port="details_k"> </td><td align="left" port="details">details</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="details_r"><font color="#475569" point-size="9.5">판정 근거 JSON</font></td></tr>
</table>>];
  logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
<tr><td colspan="4" bgcolor="#DBEAFE" align="left"><font point-size="15"><b>logs</b></font><br/><font point-size="10" color="#334155">로그 1줄 × 블록 1개 = 1행 · 실시간 판정 결과</font></td></tr>
<tr><td colspan="4" bgcolor="#F8FAFC" align="left"><font point-size="9.5" color="#475569">쓰기: 백엔드 (POST /logs) · 인덱스: (block_id, id), (status, id)</font></td></tr>
<tr><td bgcolor="#FDE68A" width="26" port="id_k"><font point-size="9"><b>PK</b></font></td><td align="left" port="id"><b>id</b></td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="id_r"><font color="#475569" point-size="9.5">저장 순서 번호 (자동 증가)</font></td></tr>
<tr><td bgcolor="white" width="26" port="timestamp_k"> </td><td align="left" port="timestamp">timestamp</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="timestamp_r"><font color="#475569" point-size="9.5">서버 수신 시각 (UTC)</font></td></tr>
<tr><td bgcolor="white" width="26" port="sent_at_k"> </td><td align="left" port="sent_at">sent_at</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="sent_at_r"><font color="#475569" point-size="9.5">재생 모듈 전송 시각 (E2E 지연용)</font></td></tr>
<tr><td bgcolor="white" width="26" port="log_date_k"> </td><td align="left" port="log_date">log_date</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="log_date_r"><font color="#475569" point-size="9.5">원본 로그 날짜 (YYMMDD)</font></td></tr>
<tr><td bgcolor="white" width="26" port="log_time_k"> </td><td align="left" port="log_time">log_time</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="log_time_r"><font color="#475569" point-size="9.5">원본 로그 시각 (HHMMSS)</font></td></tr>
<tr><td bgcolor="white" width="26" port="level_k"> </td><td align="left" port="level">level</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="level_r"><font color="#475569" point-size="9.5">INFO / WARN …</font></td></tr>
<tr><td bgcolor="white" width="26" port="component_k"> </td><td align="left" port="component">component</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="component_r"><font color="#475569" point-size="9.5">로그 발생 위치 (dfs.DataNode…)</font></td></tr>
<tr><td bgcolor="#F1F5F9" width="26" port="block_id_k"><font point-size="9"><b>IX</b></font></td><td align="left" port="block_id">block_id</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="block_id_r"><font color="#475569" point-size="9.5">블록 ID (없으면 NULL)</font></td></tr>
<tr><td bgcolor="white" width="26" port="event_id_k"> </td><td align="left" port="event_id">event_id</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="event_id_r"><font color="#475569" point-size="9.5">Drain 템플릿 번호 (처음 보는 형식 NULL)</font></td></tr>
<tr><td bgcolor="white" width="26" port="event_index_k"> </td><td align="left" port="event_index">event_index</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="event_index_r"><font color="#475569" point-size="9.5">모델 입력 번호 (UNK = 1)</font></td></tr>
<tr><td bgcolor="white" width="26" port="model_name_k"> </td><td align="left" port="model_name">model_name</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="model_name_r"><font color="#475569" point-size="9.5">판정 모델 (autoencoder)</font></td></tr>
<tr><td bgcolor="white" width="26" port="anomaly_score_k"> </td><td align="left" port="anomaly_score">anomaly_score</td><td align="left"><font color="#64748B" point-size="9.5">REAL</font></td><td align="left" port="anomaly_score_r"><font color="#475569" point-size="9.5">0~1 정규화 이상 점수</font></td></tr>
<tr><td bgcolor="white" width="26" port="threshold_k"> </td><td align="left" port="threshold">threshold</td><td align="left"><font color="#64748B" point-size="9.5">REAL</font></td><td align="left" port="threshold_r"><font color="#475569" point-size="9.5">판정 기준선 (0.5)</font></td></tr>
<tr><td bgcolor="white" width="26" port="is_anomaly_k"> </td><td align="left" port="is_anomaly">is_anomaly</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="is_anomaly_r"><font color="#475569" point-size="9.5">1 이상 / 0 정상</font></td></tr>
<tr><td bgcolor="white" width="26" port="reason_k"> </td><td align="left" port="reason">reason</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="reason_r"><font color="#475569" point-size="9.5">unknown_event / model / normal</font></td></tr>
<tr><td bgcolor="white" width="26" port="details_k"> </td><td align="left" port="details">details</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="details_r"><font color="#475569" point-size="9.5">판정 근거 JSON</font></td></tr>
<tr><td bgcolor="white" width="26" port="latency_ms_k"> </td><td align="left" port="latency_ms">latency_ms</td><td align="left"><font color="#64748B" point-size="9.5">REAL</font></td><td align="left" port="latency_ms_r"><font color="#475569" point-size="9.5">수신 → 판정 완료 지연</font></td></tr>
<tr><td bgcolor="#F1F5F9" width="26" port="status_k"><font point-size="9"><b>IX</b></font></td><td align="left" port="status">status</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="status_r"><font color="#475569" point-size="9.5">pending_model / no_block / normal / anomaly</font></td></tr>
<tr><td bgcolor="white" width="26" port="raw_log_k"> </td><td align="left" port="raw_log">raw_log</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="raw_log_r"><font color="#475569" point-size="9.5">원본 로그 한 줄</font></td></tr>
<tr><td bgcolor="white" width="26" port="alerted_k"> </td><td align="left" port="alerted">alerted</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="alerted_r"><font color="#475569" point-size="9.5">알림 보냈으면 1</font></td></tr>
</table>>];
  alerts [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
<tr><td colspan="4" bgcolor="#EDE9FE" align="left"><font point-size="15"><b>alerts</b></font><br/><font point-size="10" color="#334155">Slack 알림 1건 = 1행 · UNIQUE(block_id, model_name)</font></td></tr>
<tr><td colspan="4" bgcolor="#F8FAFC" align="left"><font point-size="9.5" color="#475569">쓰기: Slack 알림 작업자 (notifier.py) · 인덱스: timestamp</font></td></tr>
<tr><td bgcolor="#FDE68A" width="26" port="id_k"><font point-size="9"><b>PK</b></font></td><td align="left" port="id"><b>id</b></td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="id_r"><font color="#475569" point-size="9.5">알림 번호 (자동 증가)</font></td></tr>
<tr><td bgcolor="#F1F5F9" width="26" port="timestamp_k"><font point-size="9"><b>IX</b></font></td><td align="left" port="timestamp">timestamp</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="timestamp_r"><font color="#475569" point-size="9.5">알림 생성 시각 (UTC)</font></td></tr>
<tr><td bgcolor="#EDE9FE" width="26" port="block_id_k"><font point-size="9"><b>UQ</b></font></td><td align="left" port="block_id">block_id</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="block_id_r"><font color="#475569" point-size="9.5">블록 ID</font></td></tr>
<tr><td bgcolor="#EDE9FE" width="26" port="model_name_k"><font point-size="9"><b>UQ</b></font></td><td align="left" port="model_name">model_name</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="model_name_r"><font color="#475569" point-size="9.5">판정 모델</font></td></tr>
<tr><td bgcolor="#DBEAFE" width="26" port="log_id_k"><font point-size="9"><b>FK</b></font></td><td align="left" port="log_id">log_id</td><td align="left"><font color="#64748B" point-size="9.5">INTEGER</font></td><td align="left" port="log_id_r"><font color="#475569" point-size="9.5">원인 logs.id (세션 종료 원인이면 NULL)</font></td></tr>
<tr><td bgcolor="white" width="26" port="status_k"> </td><td align="left" port="status">status</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="status_r"><font color="#475569" point-size="9.5">sent / failed / pending</font></td></tr>
<tr><td bgcolor="white" width="26" port="message_k"> </td><td align="left" port="message">message</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="message_r"><font color="#475569" point-size="9.5">보낸 메시지 본문</font></td></tr>
<tr><td bgcolor="white" width="26" port="completed_at_k"> </td><td align="left" port="completed_at">completed_at</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="completed_at_r"><font color="#475569" point-size="9.5">Slack 요청 완료 시각 (E2E 계산)</font></td></tr>
<tr><td bgcolor="white" width="26" port="error_k"> </td><td align="left" port="error">error</td><td align="left"><font color="#64748B" point-size="9.5">TEXT</font></td><td align="left" port="error_r"><font color="#475569" point-size="9.5">실패 이유</font></td></tr>
</table>>];

  // 관계 (FOREIGN KEY 제약 없이 코드가 이 칸으로 연결)
  session_results:last_log_id_r:e -> logs:id_k:w [dir=both, arrowtail=crow, arrowhead=tee, color="#2563EB", fontcolor="#1D4ED8",
      label="  last_log_id → logs.id\n  N : 1  (블록의 마지막 로그)  "];
  session_results:block_id_r:e -> logs:block_id_k:w [dir=both, arrowtail=teeodot, arrowhead=crow, style=dashed, color="#D97706", fontcolor="#B45309",
      label="  block_id + model_name\n  0..1 : N  (블록의 로그들 ↔ 종료 판정)  "];
  logs:id_r:e -> alerts:log_id_k:w [dir=both, arrowtail=teeodot, arrowhead=crowodot, color="#7C3AED", fontcolor="#6D28D9",
      label="  alerts.log_id → logs.id\n  0..1 : 0..1  (NULL = 세션 종료 판정이 원인)  "];
  logs:block_id_r:e -> alerts:block_id_k:w [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, color="#7C3AED", fontcolor="#6D28D9",
      label="  block_id + model_name\n  블록·모델당 알림 최대 1건  "];

  legend [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#94A3B8">
    <tr><td colspan="2" align="left"><b>표시</b></td></tr>
    <tr><td bgcolor="#FDE68A"><b>PK</b></td><td align="left">기본키</td></tr>
    <tr><td bgcolor="#DBEAFE"><b>FK</b></td><td align="left">다른 테이블의 id 를 가리킴 (논리적 참조, SQL 제약 없음)</td></tr>
    <tr><td bgcolor="#EDE9FE"><b>UQ</b></td><td align="left">함께 유일 (같은 블록 알림 중복 방지)</td></tr>
    <tr><td bgcolor="#F1F5F9"><b>IX</b></td><td align="left">조회용 인덱스</td></tr>
    <tr><td colspan="2" align="left"><font point-size="9.5" color="#475569">실선: id 참조 · 점선: block_id + model_name 으로 묶어 조회<br/>최종 세션 판정 = logs 에 이상 행이 하나라도 있음 OR session_results.is_anomaly = 1</font></td></tr>
  </table>>];
  { rank=same; session_results; legend; }
  session_results -> legend [style=invis];
}
