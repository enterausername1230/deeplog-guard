# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ipynb_checkpoints/

# 데이터 (용량 큼 → 각자 `make data` 로 재생성)
data/raw/
data/interim/*
data/processed/*
!data/interim/parse_summary.json
!data/interim/hdfs_templates.csv
!data/processed/split_summary.json
!data/processed/event_vocab.json

# 모델/산출물 (Drain3 상태·작은 Detector 설정 json 은 백엔드 연동용으로 공유)
artifacts/*
!artifacts/drain3/
!artifacts/models/
artifacts/models/*
!artifacts/models/*.json
*.pt
*.pth
*.ckpt
# 단, 백엔드 연동용 최종 소형 모델(수백 KB)은 공유
!artifacts/models/*.pt

# 런타임
*.db
*.sqlite
*.log
!tests/**/*.log

# 비밀 정보 (Slack Webhook URL 등)
.env
.env.*

# OS / IDE
.DS_Store
.idea/
.vscode/

# 계획서 원본 (팀원 연락처 등 개인정보 포함)
docs/*.hwp
docs/*.hwpx
